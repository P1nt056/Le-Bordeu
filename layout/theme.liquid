<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  {% assign browser_page_title = page_title %}
  {% if request.page_type == 'collection' %}
    {% assign browser_page_title = collection.title %}
    {% assign collection_title_prefix = collection.title | slice: 0, 1 | downcase %}
    {% assign collection_title_second_char = collection.title | slice: 1, 1 %}
    {% assign collection_title_after_prefix = collection.title | slice: 1, 1000 | strip %}
    {% assign collection_title_prefix_separator = collection_title_after_prefix | slice: 0, 1 %}
    {% assign collection_title_size = collection.title | size %}
    {% assign collection_title_suffix_index = collection_title_size | minus: 1 %}
    {% assign collection_title_suffix_separator_index = collection_title_size | minus: 2 %}
    {% assign collection_title_suffix = collection.title | slice: collection_title_suffix_index, 1 | downcase %}
    {% assign collection_title_suffix_separator = collection.title | slice: collection_title_suffix_separator_index, 1 %}
    {% assign has_gender_suffix = false %}
    {% if collection_title_suffix == 'm' or collection_title_suffix == 'f' %}
      {% if collection_title_suffix_separator == ' ' or collection_title_suffix_separator == '-' or collection_title_suffix_separator == '_' or collection_title_suffix_separator == ':' or collection_title_suffix_separator == '|' %}
        {% assign has_gender_suffix = true %}
      {% endif %}
    {% endif %}
    {% if has_gender_suffix %}
      {% assign browser_page_title = collection.title | slice: 0, collection_title_suffix_separator_index | strip %}
    {% elsif collection_title_prefix == 'm' or collection_title_prefix == 'f' %}
      {% if collection_title_prefix_separator == '-' or collection_title_prefix_separator == '_' or collection_title_prefix_separator == ':' or collection_title_prefix_separator == '|' %}
        {% assign browser_page_title = collection_title_after_prefix | slice: 1, 1000 | strip %}
      {% elsif collection_title_second_char == ' ' %}
        {% assign browser_page_title = collection_title_after_prefix %}
      {% endif %}
    {% endif %}
  {% endif %}
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ browser_page_title }} - Le Bordeu</title>
    <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
    <link rel="shortcut icon" href="{{ 'favicon.png' | asset_url }}" type="image/png">
    {{ content_for_header }}
  </head>
  <body class="theme-le-bordeu">
    {% include 'header' %}

    <main role="main">{{ content_for_layout }}</main>

    {% include 'footer' %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.3/dist/css/splide.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.3/dist/js/splide.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/medium-zoom@1.0.6/dist/medium-zoom.min.js" defer></script>
    <script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-firestore-compat.js"></script>
    <script src="{{ 'translations.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'product.js' | asset_url }}" defer></script>
    {{ content_for_footer }}
    <div id="cart-drawer-overlay" class="cart-drawer-overlay"></div>
    {% section 'cart-drawer' %}
  </body>
</html>
