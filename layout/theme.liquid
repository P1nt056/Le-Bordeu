<!doctype html>
<html lang="pt">
  {% assign browser_page_title = page_title %}
  {% if request.page_type == 'collection' %}
    {% assign browser_page_title = collection.title %}
    {% assign collection_title_prefix = collection.title | slice: 0, 1 | downcase %}
    {% assign collection_title_second_char = collection.title | slice: 1, 1 %}
    {% assign collection_title_after_prefix = collection.title | slice: 1, 1000 | strip %}
    {% assign collection_title_prefix_separator = collection_title_after_prefix | slice: 0, 1 %}
    {% assign collection_title_size = collection.title | size %}
    {% assign collection_title_suffix_index = collection_title_size | minus: 1 %}
    {% assign collection_title_suffix_separator_index = collection_title_size | minus: 2 %}
    {% assign collection_title_suffix = collection.title | slice: collection_title_suffix_index, 1 | downcase %}
    {% assign collection_title_suffix_separator = collection.title | slice: collection_title_suffix_separator_index, 1 %}
    {% assign has_gender_suffix = false %}
    {% if collection_title_suffix == 'm' or collection_title_suffix == 'f' %}
      {% if collection_title_suffix_separator == ' ' or collection_title_suffix_separator == '-' or collection_title_suffix_separator == '_' or collection_title_suffix_separator == ':' or collection_title_suffix_separator == '|' %}
        {% assign has_gender_suffix = true %}
      {% endif %}
    {% endif %}
    {% if has_gender_suffix %}
      {% assign browser_page_title = collection.title | slice: 0, collection_title_suffix_separator_index | strip %}
    {% elsif collection_title_prefix == 'm' or collection_title_prefix == 'f' %}
      {% if collection_title_prefix_separator == '-' or collection_title_prefix_separator == '_' or collection_title_prefix_separator == ':' or collection_title_prefix_separator == '|' %}
        {% assign browser_page_title = collection_title_after_prefix | slice: 1, 1000 | strip %}
      {% elsif collection_title_second_char == ' ' %}
        {% assign browser_page_title = collection_title_after_prefix %}
      {% endif %}
    {% endif %}
  {% endif %}
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ browser_page_title }} - Le Bordeu</title>
    <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
    <link rel="shortcut icon" href="{{ 'favicon.png' | asset_url }}" type="image/png">
    {{ content_for_header }}
  </head>
  <body class="theme-le-bordeu">
    {% include 'header' %}

    <main role="main">{{ content_for_layout }}</main>

    {% include 'footer' %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.3/dist/css/splide.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.3/dist/js/splide.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/medium-zoom@1.0.6/dist/medium-zoom.min.js" defer></script>
    <script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-firestore-compat.js"></script>
    <script src="{{ 'translations.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'product.js' | asset_url }}" defer></script>
    {{ content_for_footer }}
    <div id="cart-drawer-overlay" class="cart-drawer-overlay"></div>
    <div id="shopify-section-cart-drawer" class="shopify-section">
      {% section 'cart-drawer' %}
    </div>

    <!-- Mobile Bottom Navigation -->
    <nav class="mobile-bottom-nav" role="navigation" aria-label="Navegação móvel">
      <a href="/" class="mobile-nav-item {% if request.path == '/' %}active{% endif %}" aria-label="Início">
        <span class="mobile-nav-item__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        </span>
        <span class="mobile-nav-item__label">Início</span>
      </a>
      <a href="/search" class="mobile-nav-item {% if request.path contains '/search' %}active{% endif %}" aria-label="Pesquisar">
        <span class="mobile-nav-item__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </span>
        <span class="mobile-nav-item__label">Pesquisar</span>
      </a>
      <a href="/collections" class="mobile-nav-item mobile-nav-item--center {% if request.path == '/collections' %}active{% endif %}" aria-label="Coleções">
        <span class="mobile-nav-item__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        </span>
        <span class="mobile-nav-item__label">Coleções</span>
      </a>
      <a href="/account" class="mobile-nav-item {% if request.path contains '/account' %}active{% endif %}" aria-label="Conta">
        <span class="mobile-nav-item__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </span>
        <span class="mobile-nav-item__label">Conta</span>
      </a>
      <a href="/cart" class="mobile-nav-item icon--cart" aria-label="Carrinho">
        <span class="mobile-nav-item__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <span class="cart-count-badge {% if cart.item_count == 0 %}hidden{% endif %}">{{ cart.item_count }}</span>
        </span>
        <span class="mobile-nav-item__label">Carrinho</span>
      </a>
    </nav>
  </body>
</html>
