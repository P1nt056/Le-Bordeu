<section class="hero" aria-label="Banner principal">
  <div class="hero__media" style="--hero-image: url('{{ 'hero-elegance-couple.png' | asset_url }}');">
    <img src="{{ 'hero-elegance-couple.png' | asset_url }}" alt="Le Bordeu - elegancia editorial" loading="eager" fetchpriority="high" />
  </div>
  <div class="hero__content container">
    <span class="hero__eyebrow" data-i18n="hero_eyebrow">Nova Coleção 2026</span>
    <h1 class="hero__title" data-i18n="hero_title">Elegância que se veste. <br><em>Estilo que se sente</em>.</h1>
    <p class="hero__subtitle" data-i18n="hero_sub">Descobre peças selecionadas para quem valoriza presença, conforto e sofisticação em cada detalhe.</p>
    <div class="hero__actions">
      <a href="/collections" class="btn btn--primary" data-i18n="hero_btn1">Descobrir Coleções</a>
      <a href="/collections/all" class="btn btn--ghost" data-i18n="hero_btn2">Ver Tudo</a>
    </div>
  </div>
  <div class="hero__overlay"></div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [],
  "blocks": [],
  "presets": [{"name":"Hero"}]
}
{% endschema %}
