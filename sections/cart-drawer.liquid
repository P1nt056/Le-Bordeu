<div class="cart-drawer-inner{% if cart.item_count > 0 %} has-recommendations{% endif %}">
  <!-- LEFT COLUMN: O TEU CARRINHO -->
  <div class="cart-drawer__main-col">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title"><span data-i18n="cart_title">O Teu Carrinho</span> <span class="cart-drawer__count-badge">({{ cart.item_count }})</span></h2>
      <button type="button" class="cart-drawer__close" aria-label="Fechar Carrinho" data-i18n-aria="cart_close">✕</button>
    </div>

    <div class="cart-drawer__body">
      {% if cart.item_count == 0 %}
        <div class="cart-drawer__empty">
          <p data-i18n="cart_empty">O seu carrinho está vazio de momento.</p>
          <button type="button" class="btn btn--primary cart-drawer__continue" data-i18n="cart_continue">Continuar a Comprar</button>
        </div>
      {% else %}
        <div class="cart-drawer__items">
          {% for item in cart.items %}
            <div class="cart-drawer-item" data-key="{{ item.key }}" data-product-id="{{ item.product_id }}">
              <div class="cart-drawer-item__image">
                <a href="{{ item.url }}">
                  <img src="{{ item.image | img_url: '140x' }}" alt="{{ item.title | escape }}" loading="lazy">
                </a>
              </div>
              
              <div class="cart-drawer-item__details">
                <a href="{{ item.url }}" class="cart-drawer-item__title">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <p class="cart-drawer-item__variant">{{ item.variant.title }}</p>
                {% endunless %}
                <div class="cart-drawer-item__price">{{ item.price | money }}</div>

                <div class="cart-drawer-item__actions">
                  <div class="cart-drawer-item__quantity">
                    <button type="button" class="qty-btn minus" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}">-</button>
                    <input type="number" readonly value="{{ item.quantity }}">
                    <button type="button" class="qty-btn plus" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}">+</button>
                  </div>
                  <button type="button" class="cart-drawer-item__remove" data-key="{{ item.key }}" data-i18n="cart_remove">Remover</button>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span data-i18n="cart_subtotal">Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        {% assign free_shipping_threshold = 8999 %}
        {% if cart.total_price >= free_shipping_threshold %}
          <p class="cart-free-shipping cart-free-shipping--drawer" data-i18n="cart_free_shipping_applied">Envio gratuito aplicado nesta encomenda.</p>
        {% else %}
          {% assign amount_to_free_shipping = free_shipping_threshold | minus: cart.total_price %}
          <p class="cart-free-shipping cart-free-shipping--drawer">
            <span data-i18n="cart_free_shipping_remaining_prefix">Faltam</span>
            <span>{{ amount_to_free_shipping | money }}</span>
            <span data-i18n="cart_free_shipping_remaining_suffix">para teres envio gratuito.</span>
          </p>
        {% endif %}
        <p class="cart-drawer__tax-note" data-i18n="cart_tax">Impostos e portes calculados na finalização da compra.</p>
        <a href="/checkout" class="btn btn--primary cart-drawer__checkout" data-i18n="cart_checkout">Finalizar Compra</a>
        <a href="/cart" class="btn btn--secondary cart-drawer__view-cart" data-i18n="cart_view">Ver Carrinho</a>
      </div>
    {% endif %}
  </div>

  <!-- RIGHT COLUMN: COMPLETA O TEU LOOK (ATTACHED ON THE RIGHT) -->
  {% if cart.item_count > 0 %}
    {%- comment -%} ==================== COMPLETA O TEU LOOK LOGIC ==================== {%- endcomment -%}
    {% assign cart_product_ids = '' %}
    {% assign cart_has_top = false %}
    {% assign cart_has_bottom = false %}
    {% assign cart_has_shoes = false %}
    {% assign cart_has_watch = false %}
    {% assign cart_has_accessory = false %}
    {% assign cart_has_dress = false %}
    {% assign men_score = 0 %}
    {% assign women_score = 0 %}

    {% for item in cart.items %}
      {% assign cart_product_ids = cart_product_ids | append: item.product_id | append: ',' %}
      {% assign item_text = item.product.title | append: ' ' | append: item.product.type | append: ' ' | append: item.product.tags | downcase %}
      
      {% if item_text contains 'homem' or item_text contains 'men' or item_text contains 'masculin' %}
        {% assign men_score = men_score | plus: 1 %}
      {% endif %}
      {% if item_text contains 'mulher' or item_text contains 'women' or item_text contains 'feminin' %}
        {% assign women_score = women_score | plus: 1 %}
      {% endif %}

      {% assign item_is_jacket_top = false %}
      {% if item_text contains 'jaqueta' or item_text contains 'jacket' or item_text contains 'casaco' or item_text contains 'blusao' or item_text contains 'blazer' or item_text contains 'bomber' or item_text contains 'sobretudo' or item_text contains 'parka' or item_text contains 'colete' or item_text contains 'camisola' or item_text contains 'sweater' or item_text contains 'polo' or item_text contains 't-shirt' or item_text contains 'tshirt' or item_text contains 'hoodie' or item_text contains 'camisa' or item_text contains 'shirt' or item_text contains 'cardigan' or item_text contains 'malha' %}
        {% assign item_is_jacket_top = true %}
        {% assign cart_has_top = true %}
      {% endif %}

      {% if item_is_jacket_top == false %}
        {% if item_text contains 'jean' or item_text contains 'calca' or item_text contains 'pant' or item_text contains 'denim' or item_text contains 'calcao' or item_text contains 'short' or item_text contains 'trouser' %}
          {% assign cart_has_bottom = true %}
        {% endif %}
      {% endif %}

      {% if item_text contains 'sapato' or item_text contains 'calcado' or item_text contains 'sapatilha' or item_text contains 'sneaker' or item_text contains 'shoe' or item_text contains 'boot' or item_text contains 'bota' or item_text contains 'tenis' %}
        {% assign cart_has_shoes = true %}
      {% endif %}

      {% if item_text contains 'relogio' or item_text contains 'watch' %}
        {% assign cart_has_watch = true %}
      {% endif %}

      {% if item_text contains 'chapeu' or item_text contains 'gorro' or item_text contains 'cinto' or item_text contains 'oculos' or item_text contains 'carteira' or item_text contains 'mala' or item_text contains 'bag' or item_text contains 'hat' or item_text contains 'cap' or item_text contains 'bone' or item_text contains 'beanie' or item_text contains 'belt' or item_text contains 'bijuteria' or item_text contains 'anel' or item_text contains 'colar' or item_text contains 'pulseira' or item_text contains 'estojo' %}
        {% assign cart_has_accessory = true %}
      {% endif %}

      {% if item_text contains 'vestido' or item_text contains 'dress' %}
        {% assign cart_has_dress = true %}
      {% endif %}
    {% endfor %}

    {% assign cart_gender = 'neutral' %}
    {% if men_score > women_score %}
      {% assign cart_gender = 'homem' %}
    {% elsif women_score > men_score %}
      {% assign cart_gender = 'mulher' %}
    {% endif %}

    <div class="cart-drawer__rec-col cart-drawer__recommendations" 
         data-cart-product-ids="{{ cart_product_ids }}"
         data-has-top="{{ cart_has_top }}"
         data-has-bottom="{{ cart_has_bottom }}"
         data-has-shoes="{{ cart_has_shoes }}"
         data-has-watch="{{ cart_has_watch }}"
         data-has-accessory="{{ cart_has_accessory }}"
         data-has-dress="{{ cart_has_dress }}"
         data-gender="{{ cart_gender }}">
      
      <div class="cart-drawer__rec-col-header">
        <h3 class="cart-drawer__recommendations-title" data-i18n="cart_recommendations_title">Completa o Teu Look</h3>
        <p class="cart-drawer__recommendations-subtitle" data-i18n="cart_recommendations_subtitle">Sugestões exclusivas para o teu visual</p>
      </div>

      <div class="cart-drawer__recommendations-list">
        {% assign rec_picked_top = false %}
        {% assign rec_picked_bottom = false %}
        {% assign rec_picked_shoes = false %}
        {% assign rec_picked_watch = false %}
        {% assign rec_picked_accessory = false %}
        {% assign rec_count = 0 %}

        {% for p in collections['all'].products %}
          {% if rec_count >= 4 %}
            {% break %}
          {% endif %}

          {% assign p_id_str = p.id | append: ',' %}
          {% if cart_product_ids contains p_id_str or p.available == false %}
            {% continue %}
          {% endif %}

          {% assign p_text = p.title | append: ' ' | append: p.type | append: ' ' | append: p.tags | downcase %}
          
          {%- comment -%} Check gender compatibility {%- endcomment -%}
          {% assign skip_gender = false %}
          {% if cart_gender == 'homem' %}
            {% if p_text contains 'mulher' or p_text contains 'women' or p_text contains 'vestido' or p_text contains 'dress' %}
              {% assign skip_gender = true %}
            {% endif %}
          {% elsif cart_gender == 'mulher' %}
            {% if p_text contains 'homem' or p_text contains 'men ' or p_text contains 'masculin' %}
              {% assign skip_gender = true %}
            {% endif %}
          {% endif %}

          {% if skip_gender %}
            {% continue %}
          {% endif %}

          {%- comment -%} Accurate Pillar Classification {%- endcomment -%}
          {% assign p_is_top = false %}
          {% assign p_is_bottom = false %}
          {% assign p_is_shoes = false %}
          {% assign p_is_watch = false %}
          {% assign p_is_accessory = false %}
          {% assign p_badge = '' %}
          {% assign p_badge_key = '' %}

          {%- comment -%} 1. Check Top/Jacket FIRST so denim jackets aren't marked as pants {%- endcomment -%}
          {% if p_text contains 'jaqueta' or p_text contains 'jacket' or p_text contains 'casaco' or p_text contains 'blusao' or p_text contains 'blazer' or p_text contains 'bomber' or p_text contains 'sobretudo' or p_text contains 'parka' or p_text contains 'colete' or p_text contains 'camisola' or p_text contains 'sweater' or p_text contains 'polo' or p_text contains 't-shirt' or p_text contains 'tshirt' or p_text contains 'hoodie' or p_text contains 'camisa' or p_text contains 'shirt' or p_text contains 'cardigan' or p_text contains 'malha' %}
            {% assign p_is_top = true %}
            {% assign p_badge = 'Parte de Cima' %}
            {% assign p_badge_key = 'pillar_top' %}
          {% elsif p_text contains 'jean' or p_text contains 'calca' or p_text contains 'pant' or p_text contains 'denim' or p_text contains 'calcao' or p_text contains 'short' or p_text contains 'trouser' %}
            {% assign p_is_bottom = true %}
            {% assign p_badge = 'Calças & Jeans' %}
            {% assign p_badge_key = 'pillar_bottom' %}
          {% elsif p_text contains 'sapato' or p_text contains 'calcado' or p_text contains 'sapatilha' or p_text contains 'sneaker' or p_text contains 'shoe' or p_text contains 'boot' or p_text contains 'bota' or p_text contains 'tenis' %}
            {% assign p_is_shoes = true %}
            {% assign p_badge = 'Calçado & Sapatilhas' %}
            {% assign p_badge_key = 'pillar_shoes' %}
          {% elsif p_text contains 'relogio' or p_text contains 'watch' %}
            {% assign p_is_watch = true %}
            {% assign p_badge = 'Relógio' %}
            {% assign p_badge_key = 'pillar_watch' %}
          {% elsif p_text contains 'chapeu' or p_text contains 'gorro' or p_text contains 'bone' or p_text contains 'cap' or p_text contains 'hat' or p_text contains 'beanie' or p_text contains 'cinto' or p_text contains 'oculos' or p_text contains 'carteira' or p_text contains 'mala' or p_text contains 'bag' or p_text contains 'belt' or p_text contains 'bijuteria' or p_text contains 'anel' or p_text contains 'colar' or p_text contains 'pulseira' or p_text contains 'estojo' %}
            {% assign p_is_accessory = true %}
            {% assign p_badge = 'Acessórios & Chapéus' %}
            {% assign p_badge_key = 'pillar_accessory' %}
          {% endif %}

          {%- comment -%} Pick complementary product {%- endcomment -%}
          {% assign should_pick = false %}

          {% if p_is_top and cart_has_top == false and rec_picked_top == false %}
            {% assign should_pick = true %}
            {% assign rec_picked_top = true %}
          {% elsif p_is_bottom and cart_has_bottom == false and rec_picked_bottom == false %}
            {% assign should_pick = true %}
            {% assign rec_picked_bottom = true %}
          {% elsif p_is_shoes and cart_has_shoes == false and rec_picked_shoes == false %}
            {% assign should_pick = true %}
            {% assign rec_picked_shoes = true %}
          {% elsif p_is_watch and cart_has_watch == false and rec_picked_watch == false %}
            {% assign should_pick = true %}
            {% assign rec_picked_watch = true %}
          {% elsif p_is_accessory and cart_has_accessory == false and rec_picked_accessory == false %}
            {% assign should_pick = true %}
            {% assign rec_picked_accessory = true %}
          {% endif %}

          {% if should_pick %}
            {% assign rec_count = rec_count | plus: 1 %}
            <div class="cart-rec-item" data-product-id="{{ p.id }}">
              <a href="{{ p.url }}" class="cart-rec-item__image-link">
                <img src="{{ p.featured_image | img_url: '400x' }}" alt="{{ p.title | escape }}" loading="lazy">
              </a>
              <div class="cart-rec-item__info">
                {% if p_badge != '' %}
                  <span class="cart-rec-item__badge" data-i18n="{{ p_badge_key }}">{{ p_badge }}</span>
                {% endif %}
                <a href="{{ p.url }}" class="cart-rec-item__title" title="{{ p.title | escape }}">{{ p.title }}</a>
                <div class="cart-rec-item__pricing">
                  <span class="cart-rec-item__price">{{ p.price | money }}</span>
                  {% if p.compare_at_price > p.price %}
                    <span class="cart-rec-item__compare">{{ p.compare_at_price | money }}</span>
                  {% endif %}
                </div>

                {% if p.has_only_default_variant == false %}
                  <div class="cart-rec-item__options" data-variants="{{ p.variants | json | escape }}">
                    {% for option in p.options_with_values %}
                      {% assign opt_name_lower = option.name | downcase %}
                      {% if opt_name_lower == 'color' or opt_name_lower == 'colour' or opt_name_lower == 'cor' %}
                        {% assign opt_label = 'Cor' %}
                        {% assign opt_i18n = 'option_color' %}
                      {% elsif opt_name_lower == 'size' or opt_name_lower == 'tamanho' %}
                        {% assign opt_label = 'Tamanho' %}
                        {% assign opt_i18n = 'option_size' %}
                      {% elsif opt_name_lower == 'material' %}
                        {% assign opt_label = 'Material' %}
                        {% assign opt_i18n = 'option_material' %}
                      {% elsif opt_name_lower == 'style' or opt_name_lower == 'estilo' %}
                        {% assign opt_label = 'Estilo' %}
                        {% assign opt_i18n = 'option_style' %}
                      {% else %}
                        {% assign opt_label = option.name %}
                        {% assign opt_i18n = '' %}
                      {% endif %}
                      <div class="cart-rec-item__option-group">
                        <label class="cart-rec-item__option-label" {% if opt_i18n != '' %}data-i18n="{{ opt_i18n }}"{% endif %}>{{ opt_label }}:</label>
                        <select class="cart-rec-item__option-select" data-option-index="{{ forloop.index0 }}" aria-label="{{ opt_label }} para {{ p.title | escape }}">
                          {% for value in option.values %}
                            {% assign is_selected = false %}
                            {% if option.selected_value == value %}
                              {% assign is_selected = true %}
                            {% elsif option.selected_value == blank and forloop.first %}
                              {% assign is_selected = true %}
                            {% endif %}
                            <option value="{{ value | escape }}" {% if is_selected %}selected{% endif %}>
                              {{ value }}
                            </option>
                          {% endfor %}
                        </select>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}

                <button type="button" 
                        class="cart-rec-item__add-btn" 
                        data-variant-id="{{ p.selected_or_first_available_variant.id }}"
                        {% unless p.available %}disabled{% endunless %}>
                  {% if p.available %}
                    <span class="btn-text" data-i18n="cart_btn_add">+ Adicionar</span>
                  {% else %}
                    <span class="btn-text" data-i18n="cart_sold_out">Esgotado</span>
                  {% endif %}
                </button>
              </div>
            </div>
          {% endif %}
        {% endfor %}

        {%- comment -%} If all missing pillars were filled or catalog is small, fallback to other products {%- endcomment -%}
        {% if rec_count < 2 %}
          {% for p in collections['all'].products %}
            {% if rec_count >= 3 %}
              {% break %}
            {% endif %}
            {% assign p_id_str = p.id | append: ',' %}
            {% if cart_product_ids contains p_id_str or p.available == false %}
              {% continue %}
            {% endif %}
            {% assign p_text = p.title | append: ' ' | append: p.type | append: ' ' | append: p.tags | downcase %}
            {% if cart_gender == 'homem' %}
              {% if p_text contains 'mulher' or p_text contains 'vestido' %}
                {% continue %}
              {% endif %}
            {% endif %}
            {% assign rec_count = rec_count | plus: 1 %}
            <div class="cart-rec-item" data-product-id="{{ p.id }}">
              <a href="{{ p.url }}" class="cart-rec-item__image-link">
                <img src="{{ p.featured_image | img_url: '400x' }}" alt="{{ p.title | escape }}" loading="lazy">
              </a>
              <div class="cart-rec-item__info">
                <span class="cart-rec-item__badge" data-i18n="pillar_featured">Destaque</span>
                <a href="{{ p.url }}" class="cart-rec-item__title" title="{{ p.title | escape }}">{{ p.title }}</a>
                <div class="cart-rec-item__pricing">
                  <span class="cart-rec-item__price">{{ p.price | money }}</span>
                  {% if p.compare_at_price > p.price %}
                    <span class="cart-rec-item__compare">{{ p.compare_at_price | money }}</span>
                  {% endif %}
                </div>
                {% if p.has_only_default_variant == false %}
                  <div class="cart-rec-item__options" data-variants="{{ p.variants | json | escape }}">
                    {% for option in p.options_with_values %}
                      {% assign opt_name_lower = option.name | downcase %}
                      {% if opt_name_lower == 'color' or opt_name_lower == 'colour' or opt_name_lower == 'cor' %}
                        {% assign opt_label = 'Cor' %}
                        {% assign opt_i18n = 'option_color' %}
                      {% elsif opt_name_lower == 'size' or opt_name_lower == 'tamanho' %}
                        {% assign opt_label = 'Tamanho' %}
                        {% assign opt_i18n = 'option_size' %}
                      {% elsif opt_name_lower == 'material' %}
                        {% assign opt_label = 'Material' %}
                        {% assign opt_i18n = 'option_material' %}
                      {% elsif opt_name_lower == 'style' or opt_name_lower == 'estilo' %}
                        {% assign opt_label = 'Estilo' %}
                        {% assign opt_i18n = 'option_style' %}
                      {% else %}
                        {% assign opt_label = option.name %}
                        {% assign opt_i18n = '' %}
                      {% endif %}
                      <div class="cart-rec-item__option-group">
                        <label class="cart-rec-item__option-label" {% if opt_i18n != '' %}data-i18n="{{ opt_i18n }}"{% endif %}>{{ opt_label }}:</label>
                        <select class="cart-rec-item__option-select" data-option-index="{{ forloop.index0 }}" aria-label="{{ opt_label }} para {{ p.title | escape }}">
                          {% for value in option.values %}
                            {% assign is_selected = false %}
                            {% if option.selected_value == value %}
                              {% assign is_selected = true %}
                            {% elsif option.selected_value == blank and forloop.first %}
                              {% assign is_selected = true %}
                            {% endif %}
                            <option value="{{ value | escape }}" {% if is_selected %}selected{% endif %}>
                              {{ value }}
                            </option>
                          {% endfor %}
                        </select>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
                <button type="button" 
                        class="cart-rec-item__add-btn" 
                        data-variant-id="{{ p.selected_or_first_available_variant.id }}" 
                        {% unless p.available %}disabled{% endunless %}>
                  {% if p.available %}
                    <span class="btn-text" data-i18n="cart_btn_add">+ Adicionar</span>
                  {% else %}
                    <span class="btn-text" data-i18n="cart_sold_out">Esgotado</span>
                  {% endif %}
                </button>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>
