<section class="featured-products container" aria-label="Mais Vendidos">
  <div class="featured-products__header">
    <span class="section-eyebrow" data-i18n="feat_eyebrow">Destaques da Cole&ccedil;&atilde;o</span>
    <h2 class="section-title" data-i18n="feat_best_sellers">Mais Vendidos</h2>
  </div>

  {% assign best_sellers = collections['mais-vendidos'] %}
  {% if best_sellers == empty or best_sellers.products_count == 0 %}
    {% assign best_sellers = collections['all'] %}
  {% endif %}

  <div class="featured-products__grid">
    {% for product in best_sellers.products limit: 8 %}
      <div class="product-card">
        <a href="{{ product.url }}">
          <div class="product-card__media">
            {% if product.compare_at_price_max > product.price %}
              <span class="tag tag--sale" data-i18n="prod_promo">Promo&ccedil;&atilde;o</span>
            {% endif %}
            <img src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title | escape }}" loading="lazy">
            {% if product.images.size > 1 %}
              <img class="hover-img" src="{{ product.images[1] | img_url: '800x' }}" alt="{{ product.title | escape }}" loading="lazy">
            {% endif %}
          </div>
          <div class="product-card__info">
            <h3>{{ product.title }}</h3>
            <div class="price">
              {% if product.compare_at_price_max > product.price %}
                <span class="price--old">{{ product.compare_at_price_max | money }}</span>
                <span class="price--sale">{{ product.price | money }}</span>
              {% else %}
                <span class="price--normal">{{ product.price | money }}</span>
              {% endif %}
            </div>
          </div>
        </a>
        <a href="{{ product.url }}" class="btn btn--primary btn--buy" data-i18n="feat_buy">Comprar</a>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Mais Vendidos",
  "settings": [],
  "presets": [{"name": "Mais Vendidos"}]
}
{% endschema %}
